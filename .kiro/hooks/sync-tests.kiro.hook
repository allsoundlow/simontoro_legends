{
  "enabled": true,
  "name": "Sync Tests",
  "description": "Manually trigger to analyze the current file and update or create corresponding test files. Uses Node.js built-in test runner with node:test and node:assert.",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Review the currently open file and ensure corresponding tests exist in pkg/bot/tests/ mirroring the source structure. If tests exist, update them to cover any new or modified functionality. If no tests exist for this file, create them. Use Node.js built-in test runner (node:test) with node:assert for assertions. Follow the testing patterns in .kiro/steering/testing.md - use the build() helper from tests/helper.ts for Fastify route tests."
  }
}