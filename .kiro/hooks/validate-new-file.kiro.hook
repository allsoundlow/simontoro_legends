{
  "enabled": true,
  "name": "Validate New File Structure",
  "description": "When a new TypeScript file is created in pkg/bot, validate it's in the correct directory according to the layered architecture and follows naming conventions.",
  "version": "1",
  "when": {
    "type": "fileCreated",
    "patterns": [
      "pkg/bot/**/*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A new TypeScript file was created. Validate it follows .kiro/steering/structure.md and .kiro/steering/architecture.md: 1) File is in the correct layer directory (routes/, services/, repositories/, adapters/, schemas/, connectors/), 2) Filename uses kebab-case, 3) File has appropriate boilerplate for its layer (e.g., Fastify plugin for routes, class with constructor injection for services). Suggest corrections if the file is misplaced or doesn't follow conventions."
  }
}