{
  "enabled": true,
  "name": "Lint on Save",
  "description": "Run ESLint on saved TypeScript files and automatically fix any linting errors or style issues.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run `yarn eslint --fix` on the saved file to fix any linting issues. If there are errors that can't be auto-fixed, report them and suggest manual fixes. Follow the code style conventions in .kiro/steering/code-style.md."
  }
}