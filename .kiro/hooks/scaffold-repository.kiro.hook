{
  "enabled": true,
  "name": "Scaffold Repository",
  "description": "When a new repository file is created, generate boilerplate code following the storage adapter pattern.",
  "version": "1",
  "when": {
    "type": "fileCreated",
    "patterns": [
      "pkg/bot/**/repositories/**/*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A new repository file was created. If the file is empty or minimal, scaffold it following the pattern from .kiro/steering/repositories.md: 1) Class with StorageAdapter<Entity> constructor injection, 2) Domain-specific query methods (findById using pk, findByGroupId, create, update, delete), 3) Handle timestamps (created_at, updated_at) in create/update methods, 4) Apply schema defaults in create method. Use the entity name from the filename (e.g., keyword.repository.ts → KeywordRepository for Keyword entity). Note: Use 'pk' as the primary key field name, not 'id'."
  }
}